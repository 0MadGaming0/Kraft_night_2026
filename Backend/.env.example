PORT=5000
# Optional: without this, CoLoad starts with a reset-on-restart demo store.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=coload
# Set this to a real key to deliver driver OTPs through 2Factor.
TWO_FACTOR_API_KEY=
# In demo mode the local OTP is 123456. Never use this mode in production.
DEMO_MODE=true
